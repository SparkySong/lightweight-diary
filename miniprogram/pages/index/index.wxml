<!--pages/index/index.wxml-->
<!-- 页面元信息，在 JS 中动态设置背景色和状态栏（必须作为页面第一个节点）-->
<page-meta
  background-text-style="{{currentTheme === 'light' ? 'dark' : 'light'}}"
  background-color="{{currentTheme === 'light' ? '#F8FAF9' : '#121212'}}"
  background-color-top="{{currentTheme === 'light' ? '#F8FAF9' : '#121212'}}"
  background-color-bottom="{{currentTheme === 'light' ? '#F8FAF9' : '#121212'}}"
  root-background-color="{{currentTheme === 'light' ? '#F8FAF9' : '#121212'}}"
  navigation-bar-style="{{currentTheme === 'light' ? 'dark' : 'light'}}"
/>
<view class="theme-root {{currentTheme === 'light' ? 'theme-light' : ''}}" bindtap="onPageTap" catchtap="onCancelGoalInput">
  <view class="theme-bg-fixed"></view>

<!-- 自定义导航栏区域 -->
<view class="custom-nav-area"></view>

<view class="container">
  <!-- Header -->
  <view class="header">
    <view class="header-title-row">
      <text class="title">打卡记录</text>
      <!-- 切换主题图标 -->
      <!-- <view class="header-actions" style="padding-right: {{navBarRightPadding}}px;">
        <view class="theme-toggle" bindtap="onToggleThemeMenu">
          <view class="theme-icon-svg" wx:if="{{currentThemeSetting === 'system'}}">
            <view class="icon-device"></view>
          </view>
          <view class="theme-icon-svg theme-moon" wx:elif="{{currentTheme === 'dark'}}"></view>
          <view class="theme-icon-svg theme-sun" wx:else></view>
        </view>
      </view> -->
    </view>
    <text class="subtitle" wx:if="{{streak > 0}}">已连续打卡 {{streak}} 天</text>
    <text class="subtitle" wx:else>坚持记录，遇见更好的自己</text>
    
    <!-- 主题选择菜单 -->
    <view class="theme-menu" wx:if="{{showThemeMenu}}" style="right: {{navBarRightPadding}}px;">
      <view class="theme-menu-item {{currentThemeSetting === 'system' ? 'active' : ''}}" 
            bindtap="onSwitchTheme" data-theme="system">
        <view class="theme-menu-icon icon-device-small"></view>
        <text class="theme-menu-text">跟随系统</text>
      </view>
      <view class="theme-menu-item {{currentThemeSetting === 'dark' ? 'active' : ''}}" 
            bindtap="onSwitchTheme" data-theme="dark">
        <view class="theme-menu-icon icon-moon-small"></view>
        <text class="theme-menu-text">深色模式</text>
      </view>
      <view class="theme-menu-item {{currentThemeSetting === 'light' ? 'active' : ''}}" 
            bindtap="onSwitchTheme" data-theme="light">
        <view class="theme-menu-icon icon-sun-small"></view>
        <text class="theme-menu-text">浅色模式</text>
      </view>
    </view>
  </view>

  <!-- Stats Cards - Vant组件版 -->
  <view class="stats">
    <view class="stat-card mint-card" bindtap="openWeightPopup" data-type="current">
      <text class="stat-label mint-text-secondary">当前体重</text>
      <view class="stat-value-wrap">
        <text class="stat-value mint-text-primary">{{currentWeight}}</text>
        <text class="stat-unit mint-text-tertiary" wx:if="{{currentWeight !== '--'}}">{{weightUnitLabel}}</text>
      </view>
      <text class="stat-change {{lastChangeClass}}">{{lastChange}}</text>
    </view>
    <view class="stat-card mint-card" bindtap="openWeightPopup" data-type="target">
      <text class="stat-label mint-text-secondary">目标体重</text>
      <view class="stat-value-wrap">
        <text class="stat-value mint-text-primary">{{goalWeight || '--'}}</text>
        <text class="stat-unit mint-text-tertiary" wx:if="{{goalWeight}}">{{weightUnitLabel}}</text>
      </view>
      <text class="stat-change mint-text-tertiary" wx:if="{{!goalWeight}}">未设置</text>
      <text class="stat-change {{goalReached ? 'down' : 'neutral'}}" wx:else>{{goalRemaining}}</text>
    </view>
    <view class="stat-card mint-card">
      <text class="stat-label mint-text-secondary">{{totalLost !== '--' && !totalLost.startsWith('+') ? '已减' : '变化'}}</text>
      <view class="stat-value-wrap">
        <text class="stat-value mint-text-primary" style="color:{{totalLostColor}}">{{totalLost}}</text>
        <text class="stat-unit mint-text-tertiary" wx:if="{{totalLost !== '--'}}">{{weightUnitLabel}}</text>
      </view>
      <text class="stat-change mint-text-tertiary">累计打卡 {{daysCount}} 天</text>
    </view>
  </view>

  <!-- Checkin - 主行动上移 -->
  <view class="mint-card checkin-card">
    <view class="card-title-wrap">
      <view class="title-icon icon-edit"></view>
      <text class="card-title">今日打卡</text>
    </view>
    <picker mode="date" value="{{inputDate}}" bindchange="onDateChange">
      <view class="checkin-date-row">
        <van-icon name="calendar-o" size="30rpx" color="var(--accent-text)" />
        <text class="checkin-date-text">{{inputDate || '选择日期'}}</text>
        <van-icon name="arrow-down" size="24rpx" color="var(--text-tertiary)" />
      </view>
    </picker>
    <view class="checkin-weight-row">
      <input class="checkin-weight-input" type="digit" placeholder="0.0" placeholder-class="checkin-ph" value="{{inputWeight}}" bindinput="onWeightInput" confirm-type="done" bindconfirm="onCheckin" />
      <text class="checkin-unit">{{weightUnitLabel}}</text>
    </view>
    <van-button type="primary" round block bindtap="onCheckin">打卡记录</van-button>
  </view>

  <!-- BMI Card - Vant组件版 -->
  <view class="mint-card bmi-card">
    <view class="card-header">
      <text class="card-title mint-text-primary">BMI 指数</text>
      <van-tag round type="{{bmiCategory === '正常' ? 'success' : 'warning'}}" size="medium">{{bmiCategory}}</van-tag>
    </view>
    <view class="bmi-content">
      <view class="bmi-value-wrap">
        <text class="bmi-number" style="color:{{bmiColor}}">{{bmiValue}}</text>
        <text class="bmi-range mint-text-tertiary">正常范围 18.5-24</text>
      </view>
      <view class="bmi-track">
        <view class="bmi-segment underweight"></view>
        <view class="bmi-segment normal"></view>
        <view class="bmi-segment overweight"></view>
        <view class="bmi-segment obese"></view>
        <view class="bmi-indicator" wx:if="{{bmiValue !== '--'}}" style="left: {{bmiIndicatorLeft}}%;"></view>
      </view>
      <view class="bmi-labels">
        <text class="bmi-label mint-text-tertiary">偏瘦</text>
        <text class="bmi-label mint-text-tertiary">正常</text>
        <text class="bmi-label mint-text-tertiary">偏胖</text>
        <text class="bmi-label mint-text-tertiary">肥胖</text>
      </view>
    </view>
    <!-- Height Setting -->
    <view class="height-section">
      <view wx:if="{{height && !showHeightInput}}" class="height-display">
        <text class="mint-text-secondary">身高: {{height}} cm</text>
        <text class="mint-text-accent" bindtap="onEditHeight">修改</text>
      </view>
      <view wx:else class="height-input-wrap" catchtap="stopPropagation">
        <van-field extra-event-params type="digit" placeholder="身高 (cm)" value="{{inputHeight}}" bind:input="onHeightInput" use-button-slot>
          <van-button slot="button" size="small" type="primary" bindtap="onSetHeight">保存</van-button>
        </van-field>
      </view>
    </view>
  </view>

  <!-- 今日能量 - 入口条 -->
  <view class="mint-card entry-row" bindtap="goToExercise">
    <van-icon name="fire-o" color="var(--color-primary)" size="44rpx" />
    <view class="entry-content">
      <text class="entry-title mint-text-primary">今日能量</text>
      <text class="entry-desc mint-text-tertiary">{{todayBalance <= 0 ? '还能吃 ' + (todayBalanceAbs || 0) + ' kcal' : '已超出 ' + (todayBalanceAbs || 0) + ' kcal'}} · 消耗 {{todayTotalBurn || 0}} kcal</text>
    </view>
    <van-icon name="arrow" color="var(--text-tertiary)" size="32rpx" />
  </view>

  <!-- Chart - Vant组件版 -->
  <view class="mint-card chart-card">
    <view class="card-header">
      <view class="card-title-wrap">
        <view class="title-icon icon-trend"></view>
        <text class="card-title">体重趋势</text>
      </view>
      <view class="range-btns">
        <view class="range-btn {{chartRange === 7 ? 'active' : ''}}" data-range="7" bindtap="onRangeChange">7天</view>
        <view class="range-btn {{chartRange === 30 ? 'active' : ''}}" data-range="30" bindtap="onRangeChange">30天</view>
        <view class="range-btn {{chartRange === 'all' ? 'active' : ''}}" data-range="all" bindtap="onRangeChange">全部</view>
      </view>
    </view>
    <canvas canvas-id="chart" id="chart" class="chart-canvas" />
  </view>

  <!-- Quick Actions - 优化快捷操作 -->
  <view class="quick-actions">
    <view class="action-card" bindtap="goToDiet">
      <view class="action-icon icon-food"></view>
      <text class="action-label">饮食记录</text>
      <text class="action-desc tip-text">记录每日三餐
热量一目了然</text>
      <text class="action-link">去记录</text>
    </view>
    <view class="action-card tip-card" bindtap="onRefreshTip">
      <view class="action-icon icon-tip"></view>
      <text class="action-label">今日小贴士</text>
      <text class="action-desc tip-text">{{healthTip}}</text>
      <text class="action-link">换一条</text>
    </view>
  </view>

  <!-- History - Vant组件版 -->
  <view class="mint-card history-card">
    <view class="card-title-wrap">
      <view class="title-icon icon-list"></view>
      <text class="card-title">打卡记录</text>
    </view>
    <view class="empty-state" wx:if="{{records.length === 0}}">
      <van-empty description="还没有记录，开始你的第一次打卡吧" />
    </view>
    
    <!-- 记录列表（随页面滚动，触底加载更多） -->
    <view class="records-scroll" wx:if="{{records.length > 0}}">
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="_id" wx:for-item="record" data-record="{{record}}" bindtap="onEditRecord">
          <view class="record-left">
            <text class="record-date">{{record.dateStr}}</text>
            <text class="record-weight">{{record.displayWeight || record.weight}} {{weightUnitLabel}}</text>
          </view>
          <view class="record-right">
            <view class="record-diff {{record.diffClass}}" wx:if="{{record.displayDiff !== undefined && record.displayDiff !== null}}">
              <block wx:if="{{record.displayDiff < 0}}">
                <view class="trend-icon trend-down"></view>
                <text>{{(-record.displayDiff)}}</text>
              </block>
              <block wx:elif="{{record.displayDiff > 0}}">
                <view class="trend-icon trend-up"></view>
                <text>{{record.displayDiff}}</text>
              </block>
              <block wx:else>
                <view class="trend-icon trend-flat"></view>
              </block>
            </view>
            <view class="record-actions">
              <text class="action-btn action-edit" catchtap="onEditRecord" data-record="{{record}}">编辑</text>
              <text class="action-btn action-delete" data-id="{{record._id}}" data-date="{{record.date}}" catchtap="onDelete">删除</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{hasMoreRecords || isLoadingMore}}">
        <van-loading wx:if="{{isLoadingMore}}" size="24" />
        <text class="load-more-text mint-text-tertiary" wx:if="{{isLoadingMore}}">加载中...</text>
        <text class="load-more-text mint-text-tertiary" wx:elif="{{!hasMoreRecords}}">— 已加载全部 —</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="mint-text-tertiary">每天进步一点点</text>
  </view>
</view>

<!-- 健康问答浮动入口（可拖动） -->
<view class="ai-fab {{currentTheme === 'light' ? 'theme-light' : ''}} {{fabDragging ? 'dragging' : ''}}"
      style="left: {{fabLeft}}px; top: {{fabTop}}px;"
      catchtouchstart="onFabTouchStart"
      catchtouchmove="onFabTouchMove"
      catchtouchend="onFabTouchEnd">
  <!-- 外层脉冲光晕 -->
  <view class="ai-fab-glow"></view>
  <!-- 主按钮 -->
  <view class="ai-fab-inner">
    <!-- AI 营养碗图标 -->
    <view class="ai-bowl-icon">
      <!-- 碗内食物 -->
      <view class="food-dot food-dot-1"></view>
      <view class="food-dot food-dot-2"></view>
      <view class="food-dot food-dot-3"></view>
      <!-- 碗口高光椭圆 -->
      <view class="bowl-rim"></view>
      <!-- 碗身 -->
      <view class="bowl-body"></view>
      <!-- 智能闪光 -->
      <view class="bowl-spark"></view>
    </view>
  </view>
</view>

<!-- 身高编辑已改为内联模式，不再需要全屏遮罩层 -->

<!-- 修改体重弹窗 - 居中对话框（fade 动画，无缩放跳动） -->
<van-dialog
  show="{{showEditPanel}}"
  title="修改体重"
  show-cancel-button
  use-slot
  transition="fade"
  confirm-button-color="{{currentTheme === 'light' ? '#16A34A' : '#22C55E'}}"
  bind:confirm="onSaveEdit"
  bind:cancel="closeEditPanel"
  bind:close="closeEditPanel"
>
  <view class="dialog-form weight-edit-form">
    <text class="weight-edit-label">当前体重 ({{weightUnitLabel}})</text>
    <input class="weight-edit-input" type="digit" placeholder="0.0" value="{{editWeight}}" bindinput="onEditWeightInput" cursor-spacing="150" />
    <text class="mint-text-tertiary weight-edit-date">{{editDate}}</text>
  </view>
</van-dialog>

<!-- Toast -->
<van-toast id="van-toast" />

<!-- 体重编辑弹框 - 居中对话框（fade 动画） -->
<van-dialog
  show="{{weightPopupShow}}"
  title="{{weightPopupType === 'current' ? (currentWeight !== '--' ? '编辑当前体重' : '记录当前体重') : (goalWeight ? '编辑目标体重' : '设置目标体重')}}"
  show-cancel-button
  use-slot
  transition="fade"
  confirm-button-color="{{currentTheme === 'light' ? '#16A34A' : '#22C55E'}}"
  bind:confirm="saveWeightPopup"
  bind:cancel="closeWeightPopup"
  bind:close="closeWeightPopup"
>
  <view class="dialog-form weight-edit-form">
    <text class="weight-edit-label">{{weightPopupType === 'current' ? '当前体重' : '目标体重'}} ({{weightUnitLabel}})</text>
    <input class="weight-edit-input" type="digit" placeholder="0.0" value="{{weightInputValue}}" bindinput="onWeightPopupInput" cursor-spacing="150" />
    <text class="field-error" wx:if="{{weightPopupError}}">{{weightPopupError}}</text>
  </view>
</van-dialog>
</view>
