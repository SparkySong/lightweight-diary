.ob-wrap {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 80rpx) 40rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.ob-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 48rpx;
}

.ob-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.ob-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.ob-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.ob-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--bg-hover);
  transition: all 0.3s ease;
}

.ob-dot-active {
  width: 40rpx;
  background: var(--color-primary);
}

.ob-card {
  margin-bottom: 32rpx;
}

.ob-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.ob-pill-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.ob-pill {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--bg-card-secondary);
  color: var(--text-secondary);
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.ob-pill-active {
  background: var(--color-primary-bg);
  color: var(--accent-text);
  border-color: var(--color-primary);
  font-weight: 500;
}

.ob-big-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
  border-bottom: 2rpx solid var(--color-primary);
}

.ob-big-input {
  width: 280rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text-primary);
  background: transparent;
}

.ob-unit {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.ob-tip {
  display: block;
  font-size: 24rpx;
  margin-top: 24rpx;
  text-align: center;
}

.ob-error {
  color: var(--color-error);
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.ob-footer {
  display: flex;
  gap: 20rpx;
  margin-top: auto;
}

.ob-btn-back {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--bg-hover);
  color: var(--text-secondary);
  font-size: 30rpx;
}

.ob-btn-next {
  flex: 2;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.ob-btn-next:active {
  opacity: 0.85;
}

.ob-skip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
